# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/standup_intel
# Neon (production):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/standup_db?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker:
REDIS_URL=redis://localhost:6379/0
# Upstash (production):
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Local Docker (leave QDRANT_URL blank to use host/port):
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Qdrant Cloud (production — set QDRANT_URL to override host/port):
QDRANT_URL=
QDRANT_API_KEY=

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Embeddings (HuggingFace Inference API — free tier) ───────────────────────
HF_TOKEN=

# ── GitHub App / OAuth ────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Slack App ─────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
# OAuth (set from Slack App dashboard under "OAuth & Permissions"):
# SLACK_CLIENT_ID and SLACK_CLIENT_SECRET are passed as GITHUB_CLIENT_ID/SECRET
# for the Slack OAuth flow (update auth.py if you separate these)

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ── Email (SendGrid — optional Slack fallback) ────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=digest@standup.ai

# ── App secrets ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-32-byte-random-key
ENCRYPTION_KEY=generate-a-32-byte-fernet-key
JWT_SECRET=generate-a-32-byte-random-key

# ── App config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
EVENT_RETENTION_DAYS=90

# CORS — comma-separated list (no wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# URLs used to build redirect links in OAuth flows and emails
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Analytics (PostHog — optional) ───────────────────────────────────────────
POSTHOG_API_KEY=
