# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/standup_intel

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Anthropic (LLM agents)
ANTHROPIC_API_KEY=
# HuggingFace (embeddings — free tier)
HF_TOKEN=

# GitHub App / OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Jira
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Email (SendGrid — optional, used as Slack fallback)
SENDGRID_API_KEY=
EMAIL_FROM=digest@standup.ai

# App
SECRET_KEY=generate-a-32-byte-random-key
ENCRYPTION_KEY=generate-a-32-byte-fernet-key
JWT_SECRET=generate-a-32-byte-random-key
ENVIRONMENT=development
EVENT_RETENTION_DAYS=90
# Comma-separated allowed CORS origins (no wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
